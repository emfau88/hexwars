{
  "name": "hexwars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HEXFRONT, a compact real-time territory-control campaign for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package:kongregate": "npm run build && node scripts/package-kongregate.mjs",
    "dev:y8": "vite --config vite.y8.config.ts --mode y8",
    "build:y8": "vite build --config vite.y8.config.ts --mode y8",
    "package:y8": "npm run build:y8 && node scripts/package-y8.mjs",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.js tests/*.test.ts",
    "pretest:browser": "vite build --mode test",
    "test:browser": "playwright test",
    "balance": "tsx scripts/balance-campaign.ts",
    "balance:doomstack": "tsx scripts/balance-doomstack.ts",
    "balance:guardians": "tsx scripts/balance-guardian-lab.ts",
    "balance:guardian-production": "tsx scripts/balance-guardian-production.ts",
    "balance:guardian-rollout": "tsx scripts/balance-guardian-rollout.ts",
    "balance:guardian-profiles": "tsx scripts/balance-guardian-player-profiles.ts",
    "balance:level6-diagnostic": "tsx scripts/diagnose-level6-stalemate.ts",
    "balance:relay-island": "tsx scripts/relay-island-lab.ts",
    "balance:signal-gardens": "tsx scripts/signal-gardens-lab.ts",
    "balance:profiles": "tsx scripts/profile-balance.ts",
    "artguide:level1": "tsx scripts/export-level1-art-guide.ts",
    "artguide:level2": "tsx scripts/export-map-art-guide.ts 2",
    "artguide:level2-overlay": "tsx scripts/capture-map-art-overlay.ts",
    "qa:capture:level2": "tsx scripts/capture-level-map.ts 2",
    "typecheck": "tsc -p tsconfig.json",
    "verify:production": "npm run build && node scripts/verify-production-build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0"
  }
}
